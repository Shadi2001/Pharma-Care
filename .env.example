# Copy to .env.local to override the public backend configuration.
VITE_PHARMA_API_BASE_URL=http://72.62.93.207
# auto: same-origin proxy in browsers; direct upstream access on the server.
# proxy: force same-origin access if the deployed origin is not allowed by CORS.
# direct: use only when the backend protocol and CORS permit browser access.
VITE_PHARMA_API_MODE=auto
